// Prisma schema for Salon Hub — full MVP schema (Milestone 1).
// Only User is exercised this milestone; the rest avoids schema churn later.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SALON_OWNER
  ADMIN
}

enum GenderFocus {
  MEN
  WOMEN
  UNISEX
}

enum SalonStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  salons    Salon[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
}

model Salon {
  id             String      @id @default(cuid())
  ownerId        String
  owner          User        @relation(fields: [ownerId], references: [id])
  name           String
  slug           String      @unique
  description    String
  genderFocus    GenderFocus
  status         SalonStatus @default(PENDING_VERIFICATION)
  address        String
  city           String
  lat            Float?
  lng            Float?
  phone          String
  coverImageUrl  String?
  avgRating      Float       @default(0)
  reviewCount    Int         @default(0)
  createdAt      DateTime    @default(now())

  services     Service[]
  staff        Staff[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]
  photos       SalonPhoto[]

  @@index([ownerId])
}

model SalonPhoto {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])
  url     String
  order   Int

  @@index([salonId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  icon     String?
  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  durationMinutes Int
  price           Decimal
  isActive        Boolean  @default(true)

  staffServices StaffService[]
  bookings      Booking[]

  @@index([salonId])
}

model Staff {
  id       String  @id @default(cuid())
  salonId  String
  salon    Salon   @relation(fields: [salonId], references: [id])
  name     String
  photoUrl String?
  bio      String?
  isActive Boolean @default(true)

  staffServices StaffService[]
  workingHours  WorkingHour[]
  timeOff       TimeOff[]
  bookings      Booking[]

  @@index([salonId])
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([staffId, serviceId])
}

model WorkingHour {
  id        String    @id @default(cuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id])
  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  @@unique([staffId, dayOfWeek, startTime])
}

model TimeOff {
  id            String   @id @default(cuid())
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id])
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?

  @@index([staffId])
}

// Overlap-prevention EXCLUDE constraint (btree_gist) deferred to the
// booking-engine milestone — needs a raw-SQL migration, out of scope for auth-only M1.
model Booking {
  id         String        @id @default(cuid())
  customerId String
  customer   User          @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon         @relation(fields: [salonId], references: [id])
  staffId    String
  staff      Staff         @relation(fields: [staffId], references: [id])
  serviceId  String
  service    Service       @relation(fields: [serviceId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  totalPrice Decimal
  notes      String?
  createdAt  DateTime      @default(now())

  payment Payment?
  review  Review?

  @@index([staffId, startTime, endTime])
  @@index([salonId, startTime])
}

// Field names kept gateway-agnostic (not Stripe-specific) — M5 integrates Moyasar.
model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  gatewayPaymentId String?       @unique
  gatewayInvoiceId String?
  amount           Decimal
  currency         String        @default("SAR")
  status           PaymentStatus @default(PENDING)
  refundedAmount   Decimal?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([salonId])
}

model Favorite {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon  @relation(fields: [salonId], references: [id])

  @@unique([customerId, salonId])
}
