// Prisma schema for Salon Hub.
//
// M1 shipped auth only. M2 (this revision) applies the three confirmed product
// decisions — see README.md: bilingual catalog, multi-service bookings, and a
// hybrid commission + subscription revenue model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SALON_OWNER
  ADMIN
}

enum GenderFocus {
  MEN
  WOMEN
  UNISEX
}

enum SalonStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PlanTier {
  FREE
  PREMIUM
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  salons    Salon[]
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]
}

// Catalog copy is bilingual (see README). `slug` stays single — it is URL-safe
// Latin and shared across locales so links survive a language switch.
model Salon {
  id            String      @id @default(cuid())
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id])
  nameEn        String
  nameAr        String
  slug          String      @unique
  descriptionEn String
  descriptionAr String
  genderFocus   GenderFocus
  status        SalonStatus @default(PENDING_VERIFICATION)
  address       String
  city          String
  lat           Float?
  lng           Float?
  phone         String
  coverImageUrl String?
  avgRating     Float       @default(0)
  reviewCount   Int         @default(0)

  // Negotiated per-salon override. Null falls back to the subscribed plan's
  // rate, then to the platform default. Stored as a fraction: 0.1500 = 15%.
  commissionRate Decimal? @db.Decimal(5, 4)

  createdAt DateTime @default(now())

  services     Service[]
  staff        Staff[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]
  photos       SalonPhoto[]
  payouts      Payout[]
  subscription Subscription?

  @@index([ownerId])
  @@index([status, city])
  // Proximity search is a bounding-box range scan over lat then lng, filtered to
  // approved salons first. There is no PostGIS here; this composite index is
  // what keeps "near me" from reading the whole table. Rows with a null lat are
  // excluded by the query, and Postgres keeps nulls out of the range scan.
  @@index([status, lat, lng])
}

/// Image bytes held in the database and served by `/api/images/[id]`.
///
/// Chosen over object storage because it needs no account, no keys and no bill,
/// and behaves identically on a managed Postgres once this deploys — where a
/// local upload directory would not, the filesystem being ephemeral there.
///
/// The trade is explicit: every photo grows the database and nothing is served
/// from a CDN. Uploads are therefore re-encoded to WebP and capped at 512px on
/// the long edge before they are stored, which keeps a phone photo to tens of
/// kilobytes. At real catalogue size this table should move to object storage —
/// the read path is one route, so that migration stays contained.
model Image {
  id       String @id @default(cuid())
  data     Bytes
  mimeType String
  width    Int
  height   Int
  byteSize Int

  createdAt DateTime @default(now())

  staff Staff?
}

model SalonPhoto {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])
  url     String
  order   Int

  @@index([salonId])
}

model Category {
  id       String    @id @default(cuid())
  nameEn   String
  nameAr   String
  slug     String    @unique
  icon     String?
  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  nameEn          String
  nameAr          String
  descriptionEn   String?
  descriptionAr   String?
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)

  staffServices StaffService[]
  bookingItems  BookingItem[]

  @@index([salonId])
}

model Staff {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id])
  name    String

  // Replaces a `photoUrl String?` that was modelled in M1 and never written —
  // it was null on every row. Two ways to specify a photo would be one too many,
  // so the upload path is the only one. If images later move to object storage,
  // this becomes a URL column again and `Image` is dropped.
  photoId String? @unique
  photo   Image?  @relation(fields: [photoId], references: [id])

  bioEn    String?
  bioAr    String?
  isActive Boolean @default(true)

  staffServices StaffService[]
  workingHours  WorkingHour[]
  timeOff       TimeOff[]
  bookingItems  BookingItem[]

  @@index([salonId])
}

model StaffService {
  id        String  @id @default(cuid())
  staffId   String
  staff     Staff   @relation(fields: [staffId], references: [id])
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([staffId, serviceId])
}

model WorkingHour {
  id        String    @id @default(cuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id])
  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  @@unique([staffId, dayOfWeek, startTime])
}

model TimeOff {
  id            String   @id @default(cuid())
  staffId       String
  staff         Staff    @relation(fields: [staffId], references: [id])
  startDateTime DateTime
  endDateTime   DateTime
  reason        String?

  @@index([staffId])
}

// A booking is one visit holding many services. `startTime`/`endTime` are the
// envelope over its items, denormalised so salon-level calendar queries don't
// have to aggregate; `totalPrice` is the sum of item prices.
model Booking {
  id         String        @id @default(cuid())
  customerId String
  customer   User          @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon         @relation(fields: [salonId], references: [id])
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(PENDING)
  totalPrice Decimal       @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  items   BookingItem[]
  payment Payment?
  review  Review?

  @@index([salonId, startTime])
  @@index([customerId])
}

// One service within a visit. Staff is per-item, so a single visit can span
// several people. Price and duration are snapshots taken at booking time —
// repricing a Service must never rewrite booking history.
//
// `status` is denormalised from the parent Booking (M3 decision) so overlap
// prevention can live in the database, not just the app: a partial `btree_gist`
// EXCLUDE constraint (staffId + time range) rejects any second item that
// double-books a staff member, and being partial it only counts blocking
// statuses (PENDING/CONFIRMED) so cancelled visits free their slot. The
// constraint and the `btree_gist` extension are raw SQL, appended to this
// model's migration. Every mutation that changes a Booking's status MUST update
// its items' status in the same transaction to keep the two in step.
model BookingItem {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  staffId         String
  staff           Staff         @relation(fields: [staffId], references: [id])
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  position        Int
  status          BookingStatus @default(PENDING)

  @@unique([bookingId, position])
  @@index([bookingId])
  @@index([staffId, startTime, endTime])
}

// Field names kept gateway-agnostic (not Stripe-specific) — M5 integrates Moyasar.
model Payment {
  id               String        @id @default(cuid())
  bookingId        String        @unique
  booking          Booking       @relation(fields: [bookingId], references: [id])
  gatewayPaymentId String?       @unique
  gatewayInvoiceId String?
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("SAR")
  status           PaymentStatus @default(PENDING)
  refundedAmount   Decimal?      @db.Decimal(10, 2)

  // Commission split, resolved at capture time from the effective rate so later
  // rate changes don't retroactively alter what a salon is owed.
  platformFee Decimal? @db.Decimal(10, 2)
  salonNet    Decimal? @db.Decimal(10, 2)

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payoutId])
}

// A settlement to a salon covering every Payment in the period.
model Payout {
  id          String       @id @default(cuid())
  salonId     String
  salon       Salon        @relation(fields: [salonId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("SAR")
  status      PayoutStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  reference   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payments Payment[]

  @@index([salonId, status])
}

// Subscription tier sold to salons, alongside per-booking commission.
model Plan {
  id              String          @id @default(cuid())
  tier            PlanTier        @unique
  nameEn          String
  nameAr          String
  price           Decimal         @db.Decimal(10, 2)
  billingInterval BillingInterval
  // Premium tiers can buy a reduced commission. Null means platform default.
  commissionRate  Decimal?        @db.Decimal(5, 4)
  isActive        Boolean         @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                    String             @id @default(cuid())
  salonId               String             @unique
  salon                 Salon              @relation(fields: [salonId], references: [id])
  planId                String
  plan                  Plan               @relation(fields: [planId], references: [id])
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  gatewaySubscriptionId String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([salonId])
}

/// Reviews of the Salon Hub platform itself (testimonials), shown at the bottom
/// of the landing page. Unlike Review, these are not tied to a booking or salon.
model SiteReview {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Favorite {
  id         String @id @default(cuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id])
  salonId    String
  salon      Salon  @relation(fields: [salonId], references: [id])

  @@unique([customerId, salonId])
}
