DATABASE_URL="postgresql://salonhub:salonhub@localhost:5432/salonhub?schema=public"

# Auth.js v5 names. NEXTAUTH_SECRET is still read as a fallback, but AUTH_SECRET
# is the current one. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Do NOT set AUTH_URL / NEXTAUTH_URL. `trustHost: true` in src/server/auth/config.ts
# covers host trust, and setting a URL here makes Auth.js rebase every request
# origin onto it — which sends locale redirects to the wrong host on any deploy
# whose origin differs (preview builds, staging, a proxy with a different port).
